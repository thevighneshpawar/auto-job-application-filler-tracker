{
  "manifest_version": 3,
  "name": "Job Filler",
  "version": "2.1.0",
  "description": "Auto-fill job application forms from your saved profile. Track applications with a built-in dashboard. 100% offline — no servers, no tracking, no data ever leaves your browser.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "unlimitedStorage", "activeTab", "tabs"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Job Filler"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["tracker.html", "tracker.js", "lib/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "commands": {
    "fill-page": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "Fill this page"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["schema.js", "content.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ]
}
